{
  "name": "dsh-plugin-deck-studio",
  "version": "0.2.10",
  "description": "Deckline：DSH 的 image deck / PPT 工作台插件——原生 Chat + 整页图片 deck 工作区 + 设计风格库；用对话做 PPT、按页出图、版本可追踪、导出 PDF/PPTX。",
  "homepage": "https://github.com/yuna78/dsh-deck-studio#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuna78/dsh-deck-studio.git",
    "directory": "plugin/deck-studio"
  },
  "bugs": {
    "url": "https://github.com/yuna78/dsh-deck-studio/issues"
  },
  "private": false,
  "license": "MIT",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./capabilities": "./lib/capabilities.js",
    "./package.json": "./package.json"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deck",
    "image-deck",
    "presentation",
    "slides",
    "ppt",
    "pptx",
    "powerpoint",
    "ai-ppt",
    "slide-deck",
    "deckline",
    "幻灯片",
    "演示文稿"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "scripts": {
    "verify": "node verify/smoke.mjs",
    "prepublishOnly": "node verify/smoke.mjs",
    "prepack": "node scripts/prepack-assets.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "renderer",
        "layout",
        "sidebar"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "author": "Yuna",
  "files": [
    "index.js",
    "client.js",
    "lib/",
    "ui/",
    "seeds/",
    "cordis.patch.yml",
    "cordis.example.yml"
  ]
}
